    "onboarding.map.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dangerous crossings, rubbish, insecurity: report what you see in 20 seconds and follow what the city does about it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carrefours dangereux, saleté, insécurité : signalez ce que vous voyez en 20 secondes et suivez ce que la ville en fait."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gevaarlijke kruispunten, afval, onveiligheid: meld wat je ziet in 20 seconden en volg wat de stad ermee doet."
          }
        }
      }
    },
    "onboarding.map.title" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
