            "value" : "The living map of Brussels"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte vivante de Bruxelles"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De levende kaart van Brussel"
          }
        }
      }
    },
    "onboarding.neighbours.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A zone appears on the map only when several people report the same thing in the same place. That keeps the map fair and fake reports out."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une zone n'apparaît sur la carte que lorsque plusieurs personnes signalent la même chose au même endroit. La carte reste juste et les faux signalements restent dehors."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een zone verschijnt pas op de kaart als meerdere mensen hetzelfde melden op dezelfde plek. Zo blijft de kaart eerlijk en blijven valse meldingen buiten."
          }
        }
      }
    },
    "onboarding.neighbours.footnote" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In danger? Call 112. Brusk is not an emergency service."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En danger ? Appelez le 112. Brusk n'est pas un service d'urgence."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In gevaar? Bel 112. Brusk is geen hulpdienst."
          }
        }
      }
    },
    "onboarding.neighbours.title" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
