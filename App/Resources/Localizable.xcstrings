    "complaint.step.bring.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your identity card, the summary below, any photos, and witnesses' contact details if they agree."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre carte d'identité, le récapitulatif ci-dessous, vos photos éventuelles et les coordonnées de témoins s'ils sont d'accord."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je identiteitskaart, de samenvatting hieronder, eventuele foto's en de gegevens van getuigen als ze akkoord gaan."
          }
        }
      }
    },
    "complaint.step.bring.title" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What to bring"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quoi apporter"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat meebrengen"
          }
        }
      }
    },
    "complaint.step.rights.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are entitled to a copy of your statement and to be kept informed. You can also register as an injured party."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez droit à une copie de votre déclaration et à être informé·e de la suite. Vous pouvez aussi faire une déclaration de personne lésée."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt recht op een kopie van je verklaring en om op de hoogte gehouden te worden. Je kan je ook benadeelde persoon stellen."
          }
        }
      }
    },
    "complaint.step.rights.title" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your rights"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos droits"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je rechten"
          }
        }
      }
    },
    "complaint.step.safety.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you are in danger or hurt, call 112. After sexual violence, the CPVS at CHU Saint-Pierre offers care 24/7 and can take your complaint on site."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous êtes en danger ou blessé·e, appelez le 112. Après des violences sexuelles, le CPVS du CHU Saint-Pierre vous accueille 24 h/24 et peut recevoir votre plainte sur place."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ben je in gevaar of gewond, bel 112. Na seksueel geweld biedt het ZSG in het UMC Sint-Pieter 24/7 zorg en kan je er ter plaatse klacht indienen."
          }
        }
      }
    },
    "complaint.step.safety.title" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your safety first"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre sécurité d'abord"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eerst je veiligheid"
          }
        }
      }
    },
    "complaint.step.support.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can ask to be accompanied. Victim support services offer free, confidential help before and after the complaint."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez demander à être accompagné·e. Les services d'aide aux victimes offrent une aide gratuite et confidentielle avant et après la plainte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je mag je laten begeleiden. Slachtofferhulp biedt gratis en vertrouwelijke hulp, voor en na de klacht."
          }
        }
      }
    },
    "complaint.step.support.title" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're not alone"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n'êtes pas seul·e"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je staat er niet alleen voor"
          }
        }
      }
    },
    "complaint.step.where.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can file a complaint at any police station, wherever the facts happened. Some offences can also be reported online on Police-on-web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez porter plainte dans n'importe quel commissariat, quel que soit le lieu des faits. Certaines infractions peuvent aussi être déclarées en ligne sur Police-on-web."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kan klacht indienen in elk politiekantoor, waar de feiten ook gebeurden. Sommige misdrijven kan je ook online aangeven via Police-on-web."
          }
        }
      }
    },
    "complaint.step.where.title" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where to go"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où aller"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waar naartoe"
          }
        }
      }
    },
