            "state" : "translated",
            "value" : "Confirmed by neighbours"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmé par les voisin·es"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevestigd door buren"
          }
        }
      }
    },
    "onboarding.privacy.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No names, no descriptions, no suspect photos. Faces and plates are blurred on your phone. Your identity is never shown, not even as a nickname."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni noms, ni descriptions, ni photos de suspects. Les visages et les plaques sont floutés sur votre téléphone. Votre identité n'est jamais affichée, pas même un pseudo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen namen, geen beschrijvingen, geen foto's van verdachten. Gezichten en nummerplaten worden op je telefoon vervaagd. Je identiteit wordt nooit getoond, zelfs geen bijnaam."
          }
        }
      }
    },
    "onboarding.privacy.footnote" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We only keep what the service needs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous ne gardons que le strict nécessaire."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We bewaren enkel wat strikt nodig is."
          }
        }
      }
    },
    "onboarding.privacy.title" : {
