    "privacy.collect.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your e-mail, to sign in. For each report: a category, a place, a time, and optionally a short note and a blurred photo. For a walk home: your contact's e-mail and your latest position."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre e-mail, pour la connexion. Pour chaque signalement : une catégorie, un lieu, une heure et, si vous le souhaitez, une courte note et une photo floutée. Pour un trajet : l'e-mail de votre contact et votre dernière position."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je e-mailadres, om aan te melden. Per melding: een categorie, een plek, een tijdstip en eventueel een korte notitie en een vervaagde foto. Voor een wandeling naar huis: het e-mailadres van je contactpersoon en je laatste positie."
          }
        }
      }
    },
    "privacy.collect.title" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What we collect"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que nous collectons"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat we verzamelen"
          }
        }
      }
    },
    "privacy.never.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Names, descriptions or photos of people, your contacts, your location in the background outside a walk, advertising or tracking identifiers."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des noms, descriptions ou photos de personnes, vos contacts, votre position en arrière-plan hors d'un trajet, des identifiants publicitaires ou de pistage."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namen, beschrijvingen of foto's van personen, je contacten, je locatie op de achtergrond buiten een wandeling, reclame- of trackingidentificatoren."
          }
        }
      }
    },
    "privacy.never.title" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What we never collect"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que nous ne collectons jamais"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat we nooit verzamelen"
          }
        }
      }
    },
    "privacy.retention.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reports are made anonymous after 12 months. Walk data is erased 24 hours after the walk. Deleting your account erases your data immediately."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les signalements sont anonymisés après 12 mois. Les données de trajet sont effacées 24 heures après le trajet. Supprimer votre compte efface vos données immédiatement."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen worden na 12 maanden geanonimiseerd. Wandelgegevens worden 24 uur na de wandeling gewist. Je account verwijderen wist je gegevens meteen."
          }
        }
      }
    },
    "privacy.retention.title" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How long"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combien de temps"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe lang"
          }
        }
      }
    },
    "privacy.rights.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under the GDPR you can access, correct and erase your data. Delete your account here at any time; data is hosted in the EU."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le RGPD vous permet d'accéder à vos données, de les corriger et de les effacer. Supprimez votre compte ici à tout moment ; les données sont hébergées dans l'UE."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volgens de AVG kan je je gegevens inzien, verbeteren en wissen. Verwijder je account hier op elk moment; de gegevens worden in de EU gehost."
          }
        }
      }
    },
    "privacy.rights.title" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your rights"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos droits"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je rechten"
          }
        }
      }
    },
    "privacy.who.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone sees aggregated zones only. You alone see your reports and their exact place. Confirmed road and cleanliness reports go to the responsible service. Theft, aggression and harassment are never passed to the police without your consent."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde ne voit que des zones agrégées. Vous seul·e voyez vos signalements et leur emplacement exact. Les signalements confirmés de voirie et de propreté sont transmis au service compétent. Vols, agressions et harcèlement ne sont jamais transmis à la police sans votre accord."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen ziet enkel samengevoegde zones. Alleen jij ziet je meldingen en hun exacte plek. Bevestigde meldingen over wegen en netheid gaan naar de bevoegde dienst. Diefstal, agressie en intimidatie gaan nooit zonder je toestemming naar de politie."
          }
        }
      }
    },
    "privacy.who.title" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Who sees what"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui voit quoi"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie ziet wat"
          }
        }
      }
    },
